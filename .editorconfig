# Standardized EditorConfig — Managed by Heretek-AI/.github
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,pyi,rs,c,cc,cpp,cxx,h,hh,hpp,hxx,cs}]
indent_size = 4

[*.{gd,gdshader}]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
