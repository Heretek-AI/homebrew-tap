{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": 1,
  "defaults": {
    "tier1": {
      "check_linkage": true,
      "forbidden_strings": ["not found", "undefined symbol"]
    },
    "tier2": {
      "timeout_seconds": 30
    },
    "tier3": {
      "timeout_seconds": 60,
      "min_tokens_per_sec": 0.01
    }
  },
  "formulas": {
    "gufo": {
      "binaries": ["bin/gufo", "bin/gufo-server"],
      "rocm": {
        "required_libs": ["libamdhip64.so"],
        "version_cmd": ["bin/gufo", "version"],
        "help_cmd": ["bin/gufo", "--help"],
        "device_cmd": ["bin/gufo", "info"],
        "device_ok_regex": "(?i)(gfx1151|strix halo|radeon|device|compute unit)",
        "no_device_ok_regex": "(?i)(no (gpu|device|accelerator)|fallback|hip error|failed to initialize hip)",
        "golden_cmd": ["bin/gufo", "test", "--mock"],
        "throughput_regex": "(?i)([0-9.]+)\\s*(tok/s|t/s|tokens/sec|ms/tok)"
      }
    },
    "gufetto": {
      "binaries": ["bin/gufo", "bin/gufo-server"],
      "rocm": {
        "required_libs": ["libamdhip64.so"],
        "version_cmd": ["bin/gufo", "version"],
        "help_cmd": ["bin/gufo", "--help"],
        "device_cmd": ["bin/gufo", "info"],
        "device_ok_regex": "(?i)(gfx1151|strix halo|radeon|device|compute unit)",
        "no_device_ok_regex": "(?i)(no (gpu|device|accelerator)|fallback|hip error|failed to initialize hip)",
        "golden_cmd": ["bin/gufo", "test", "--mock"],
        "throughput_regex": "(?i)([0-9.]+)\\s*(tok/s|t/s|tokens/sec|ms/tok)"
      }
    },
