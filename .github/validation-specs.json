    "hyperqwen": {
      "binaries": ["bin/hyperqwen", "bin/hyperqwen-bench"],
      "cuda": {
        "required_libs": ["libcudart.so"],
        "version_cmd": ["bin/hyperqwen", "--version"],
        "help_cmd": ["bin/hyperqwen", "--help"],
        "device_cmd": ["bin/hyperqwen", "--check-gpu"],
        "device_ok_regex": "(?i)(cuda|nvidia|sm_[0-9]+|geforce|rtx|tesla|a100|h100)",
        "no_device_ok_regex": "(?i)(cuda error|no (cuda-capable|gpu|device)|driver not loaded)",
        "golden_cmd": ["bin/hyperqwen-bench", "--mock-eval"],
        "throughput_regex": "(?i)([0-9.]+)\\s*(tok/s|t/s|tokens/sec|items/s)"
      }
    },
    "qwenox": {
