# Apple Silicon macOS (Metal and CPU paths).
# Usage: brew bundle --file=Brewfiles/apple-silicon.Brewfile

tap "heretek-ai/tap", trusted: { formulae: [
  "colibri",
  "gemma-cpp",
  "infr",
  "magnitude",
  "project-maya",
  "saient-quartz",
  "shimmy",
  "stable-diffusion-cpp",
  "strata",
  "uzu",
] }

brew "colibri"
brew "gemma-cpp"
brew "infr"
brew "magnitude"
brew "project-maya"
brew "saient-quartz"
brew "shimmy"
brew "stable-diffusion-cpp"
brew "strata"
brew "uzu"
