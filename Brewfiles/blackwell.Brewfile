# NVIDIA Blackwell consumer GPUs (CUDA sm_120) and DGX Spark (sm_121) on Linux.
# Usage: brew bundle --file=Brewfiles/blackwell.Brewfile

tap "heretek-ai/tap", trusted: { formulae: [
  "basalt",
  "cuda-runtime",
  "hyperqwen",
  "lucebox",
  "xolotl",
] }

brew "cuda-runtime"

brew "basalt"
brew "hyperqwen"
brew "lucebox"
brew "xolotl"
