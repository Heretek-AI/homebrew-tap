# AMD Strix Halo / Ryzen AI Max (gfx1151) on Linux.
# Usage: brew bundle --file=Brewfiles/strix-halo.Brewfile

tap "heretek-ai/tap", trusted: { formulae: [
  "crucible-strix-halo",
  "gufetto",
  "gufo",
  "gufo-franzmoca",
  "kyojin",
  "libosmos",
  "qwenox",
  "rocm-runtime",
  "rocmfpx",
  "snowllm",
  "strixite",
] }

brew "rocm-runtime"

brew "crucible-strix-halo"
brew "gufetto"
brew "gufo"
brew "gufo-franzmoca"
brew "kyojin"
brew "libosmos"
brew "qwenox"
brew "rocmfpx"
brew "snowllm"
brew "strixite"
