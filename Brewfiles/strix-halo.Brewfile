# AMD Strix Halo / Ryzen AI Max (gfx1151) on Linux.
# Usage: brew bundle --file=Brewfiles/strix-halo.Brewfile

tap "heretek-ai/tap", trusted: { formulae: [
  "crucible-strix-halo",
  "gufo",
  "gufo-ds41",
  "kyojin",
  "libosmos",
  "qwenox",
  "rocm-runtime",
  "rulith-inference",
  "snowllm",
  "strixite",
  "strixolotl",
] }

brew "rocm-runtime"

brew "crucible-strix-halo"
brew "gufo"
brew "gufo-ds41"
brew "kyojin"
brew "libosmos"
brew "qwenox"
brew "rulith-inference"
brew "snowllm"
brew "strixite"
brew "strixolotl"
